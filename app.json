{
  "name": "ExactQuizBot",
  "description": "Telegram Quiz Bot — exact QuizBot clone with group leaderboard & speed scoring",
  "keywords": ["telegram", "quiz", "bot", "python"],
  "env": {
    "TELEGRAM_TOKEN": {
      "description": "Telegram Bot Token from @BotFather",
      "required": true
    },
    "MONGO_URI": {
      "description": "MongoDB connection string (MongoDB Atlas free tier works)",
      "required": true
    },
    "DB_NAME": {
      "description": "MongoDB database name",
      "value": "exactquizbot",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    { "url": "heroku/python" }
  ]
}
